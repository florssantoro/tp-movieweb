<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { pageTitle: user.user_username }) %>
</head>
<body>
<%- include('partials/header') %>
<%
const initials = String(user.user_name || user.user_username || '?').trim().split(/\s+/).slice(0, 2).map((word) => word[0]).join('').toUpperCase();
%>

<main class="page">
    <div class="container">
        <header class="profile-head">
            <span class="avatar avatar-lg" aria-hidden="true"><%= initials %></span>
            <div>
                <p class="eyebrow">Perfil</p>
                <h1><%= user.user_username %></h1>
                <p class="profile-meta"><%= user.user_name %><% if (isOwnProfile) { %> · <%= user.user_email %><% } %></p>
            </div>
            <% if (isOwnProfile) { %>
            <div class="profile-actions">
                <a class="btn btn-ghost btn-sm" href="/perfil/editar">Editar perfil</a>
            </div>
            <% } %>
        </header>

        <section class="section" aria-labelledby="user-movies-heading">
            <h2 class="section-title" id="user-movies-heading">Películas <span class="count"><%= movies.length %></span></h2>
            <% if (movies.length === 0) { %>
                <p class="empty">Este usuario todavía no guardó películas ni valoraciones.</p>
            <% } else { %>
                <ul class="row-list">
                    <% movies.forEach((movie) => { %>
                        <li class="row">
                            <span class="row-year"><%= movie.release_date ? new Date(movie.release_date).getFullYear() : '—' %></span>
                            <div class="row-body">
                                <a class="row-title" href="/pelicula/<%= movie.movie_id %>"><%= movie.title %></a>
                                <div class="chips interaction-tags">
                                    <% if (movie.is_favorite) { %><span class="chip chip-match">Favorita</span><% } %>
                                    <% if (movie.watch_status) { %><span class="chip"><%= movie.watch_status === 'watched' ? 'Vista' : 'Quiero ver' %></span><% } %>
                                </div>
                                <% if (movie.rating) { %>
                                    <p class="row-detail">
                                        <strong>Puntuación:</strong>
                                        <span class="stars" aria-label="<%= movie.rating %> de 5"><%= '★'.repeat(movie.rating) %><span class="stars-off"><%= '★'.repeat(5 - movie.rating) %></span></span>
                                    </p>
                                <% } %>
                                <% if (movie.opinion) { %>
                                    <p class="quote">"<%= movie.opinion %>"</p>
                                <% } %>
                                <% if (isOwnProfile) { %><a class="interaction-edit" href="/pelicula/<%= movie.movie_id %>#rate-heading">Editar interacción →</a><% } %>
                            </div>
                        </li>
                    <% }); %>
                </ul>
            <% } %>
        </section>

        <section class="section" aria-labelledby="activity-heading">
            <h2 class="section-title" id="activity-heading">Actividad reciente</h2>
            <%
            const formatDate = new Intl.DateTimeFormat('es-AR', {
                dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Argentina/Buenos_Aires',
            });
            const icons = { RATED_MOVIE: '★', ADDED_TO_FAVORITES: '♥', WROTE_REVIEW: '✎' };
            %>
            <% if (!activityAvailable) { %>
                <p class="empty">La actividad no está disponible en este momento.</p>
            <% } else if (activity.length === 0) { %>
                <p class="empty">Todavía no hay actividad.</p>
            <% } else { %>
                <ol class="timeline">
                    <% activity.forEach((event) => { %>
                        <% const movieLink = `/pelicula/${event.details.movieId}`; %>
                        <% const movieTitle = event.details.movieTitle || 'una película'; %>
                        <li class="timeline-item">
                            <span class="timeline-icon timeline-icon-<%= event.type.toLowerCase() %>" aria-hidden="true"><%= icons[event.type] %></span>
                            <div class="timeline-body">
                                <p class="timeline-text">
                                    <strong><%= user.user_username %></strong>
                                    <% if (event.type === 'RATED_MOVIE') { %>
                                        calificó la película <a href="<%= movieLink %>"><%= movieTitle %></a>
                                        con <%= event.details.rating %> <%= event.details.rating === 1 ? 'estrella' : 'estrellas' %>
                                        <span class="stars" aria-hidden="true"><%= '★'.repeat(event.details.rating) %></span>
                                    <% } else if (event.type === 'ADDED_TO_FAVORITES') { %>
                                        añadió la película <a href="<%= movieLink %>"><%= movieTitle %></a> a su lista de favoritos
                                    <% } else if (event.type === 'WROTE_REVIEW') { %>
                                        escribió una reseña para la película <a href="<%= movieLink %>"><%= movieTitle %></a>
                                    <% } %>
                                </p>
                                <% if (event.type === 'WROTE_REVIEW' && event.details.opinion) { %>
                                    <p class="quote">"<%= event.details.opinion %>"</p>
                                <% } %>
                                <time class="timeline-date" datetime="<%= new Date(event.timestamp).toISOString() %>"><%= formatDate.format(new Date(event.timestamp)) %></time>
                            </div>
                        </li>
                    <% }); %>
                </ol>
            <% } %>
        </section>

        <a class="back-link" href="<%= isOwnProfile ? '/' : '/usuarios' %>">← <%= isOwnProfile ? 'Volver al inicio' : 'Volver a usuarios' %></a>
    </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
