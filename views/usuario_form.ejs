<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { pageTitle: title }) %>
</head>
<body>
<%- include('partials/header') %>

<main class="page">
    <div class="container">
        <header class="page-header">
            <p class="eyebrow">Usuarios</p>
            <h1><%= title %></h1>
        </header>

        <form class="form-card" action="<%= action %>" method="POST">
            <% if (error) { %>
                <p class="alert" role="alert"><%= error %></p>
            <% } %>

            <div class="field">
                <label for="user_username">Username</label>
                <input class="input" id="user_username" name="user_username" value="<%= values.user_username %>" maxlength="50" required autocomplete="off">
            </div>
            <div class="field">
                <label for="user_name">Nombre</label>
                <input class="input" id="user_name" name="user_name" value="<%= values.user_name %>" maxlength="100" required>
            </div>
            <div class="field">
                <label for="user_email">Email</label>
                <input class="input" id="user_email" name="user_email" type="email" value="<%= values.user_email %>" maxlength="255" required>
            </div>
            <div class="form-actions">
                <button class="btn" type="submit">Guardar</button>
                <a class="btn btn-ghost" href="/usuarios">Cancelar</a>
            </div>
        </form>
    </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
