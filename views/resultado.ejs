<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Resultados - MovieWeb</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header"><a class="brand" href="/">MovieWeb</a></header>
  <main class="container">
    <h1>Resultados</h1>
    <form class="search-form" action="/buscar" method="get">
      <label for="q">Nueva busqueda</label>
      <div class="search-row">
        <input id="q" name="q" type="search" value="<%= query %>" required>
        <button type="submit">Buscar</button>
      </div>
    </form>
    <% if (!peliculas.length && !actores.length && !directores.length) { %>
      <p>No se encontraron resultados para "<%= query %>".</p>
    <% } %>
    <section>
      <h2>Peliculas</h2>
      <% if (peliculas.length) { %>
        <ul class="result-list">
          <% peliculas.forEach((pelicula) => { %>
            <li><a href="/pelicula/<%= pelicula.movie_id %>"><%= pelicula.title %></a><% if (pelicula.release_date) { %><span class="muted"> · <%= new Date(pelicula.release_date).getFullYear() %></span><% } %></li>
          <% }); %>
        </ul>
      <% } else { %><p class="muted">Sin resultados.</p><% } %>
    </section>
    <section>
      <h2>Actores</h2>
      <% if (actores.length) { %>
        <ul class="result-list"><% actores.forEach((actor) => { %><li><a href="/actor/<%= actor.person_id %>"><%= actor.person_name %></a></li><% }); %></ul>
      <% } else { %><p class="muted">Sin resultados.</p><% } %>
    </section>
    <section>
      <h2>Directores</h2>
      <% if (directores.length) { %>
        <ul class="result-list"><% directores.forEach((director) => { %><li><a href="/director/<%= director.person_id %>"><%= director.person_name %></a></li><% }); %></ul>
      <% } else { %><p class="muted">Sin resultados.</p><% } %>
    </section>
  </main>
</body>
</html>
