<!DOCTYPE html><html lang="es"><head><%- include('partials/head', { pageTitle: title }) %></head><body><%- include('partials/header') %><main class="discovery container"><a href="/">← Inicio</a><header class="discovery-intro"><p class="eyebrow">EXPLORÁ EL CATÁLOGO</p><h1><%= title %></h1><p>Películas con al menos 200 votos. Encontrá tu próxima historia.</p></header><form class="discovery-filters" method="GET" action="/explorar"><div class="field"><label for="genre">Género</label><select class="select" name="genero" id="genre"><option value="">Todos</option><% genres.forEach((g) => { %><option value="<%= g.id %>" <%= genre?.id === g.id ? 'selected' : '' %>><%= g.name %></option><% }); %></select></div><div class="field"><label for="order">Ordenar</label><select class="select" name="orden" id="order"><option value="rating" <%= order === 'rating' ? 'selected' : '' %>>Mejor puntuadas</option><option value="popular" <%= order === 'popular' ? 'selected' : '' %>>Más populares</option></select></div><button class="btn" type="submit">Aplicar</button></form><%- include('partials/movie_cards', { movies }) %><nav class="pagination" aria-label="Páginas"><% if (page > 1) { %><a class="btn btn-ghost" href="/explorar?<%= query %>&page=<%= page - 1 %>">← Anterior</a><% } %><span>Página <%= page %></span><% if (hasNext) { %><a class="btn btn-ghost" href="/explorar?<%= query %>&page=<%= page + 1 %>">Siguiente →</a><% } %></nav></main><%- include('partials/footer') %></body></html>
