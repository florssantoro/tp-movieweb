<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { pageTitle: 'Ingresar' }) %></head>
<body>
<%- include('partials/header') %>
<main class="page"><div class="container auth-layout">
    <header class="page-header"><p class="eyebrow">Tu cuenta</p><h1>Ingresar</h1><p>Continuá con tus películas, puntuaciones y opiniones.</p></header>
    <form class="form-card" action="/login" method="POST">
        <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
        <div class="field"><label for="identifier">Username o email</label><input class="input" id="identifier" name="identifier" value="<%= identifier %>" maxlength="255" autocomplete="username" required autofocus></div>
        <div class="field"><label for="password">Contraseña</label><input class="input" id="password" name="password" type="password" maxlength="72" autocomplete="current-password" required></div>
        <div class="form-actions"><button class="btn" type="submit">Ingresar</button><a class="btn btn-ghost" href="/registro">Crear cuenta</a></div>
    </form>
</div></main>
<%- include('partials/footer') %>
</body></html>
