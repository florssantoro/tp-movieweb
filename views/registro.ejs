<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { pageTitle: 'Crear cuenta' }) %></head>
<body>
<%- include('partials/header') %>
<main class="page"><div class="container auth-layout">
    <header class="page-header"><p class="eyebrow">MovieWeb</p><h1>Crear cuenta</h1><p>Guardá películas y armá tu perfil personal.</p></header>
    <form class="form-card" action="/registro" method="POST">
        <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
        <div class="field"><label for="user_username">Username</label><input class="input" id="user_username" name="user_username" value="<%= values.user_username %>" minlength="3" maxlength="50" pattern="[A-Za-z0-9._-]{3,50}" title="Usá entre 3 y 50 letras, números, puntos, guiones o guiones bajos." autocomplete="username" required></div>
        <div class="field"><label for="user_name">Nombre</label><input class="input" id="user_name" name="user_name" value="<%= values.user_name %>" maxlength="100" autocomplete="name" required></div>
        <div class="field"><label for="user_email">Email</label><input class="input" id="user_email" name="user_email" type="email" value="<%= values.user_email %>" maxlength="255" autocomplete="email" required></div>
        <div class="field"><label for="password">Contraseña</label><input class="input" id="password" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required><small class="field-help">Entre 8 y 72 caracteres.</small></div>
        <div class="field"><label for="password_confirmation">Repetir contraseña</label><input class="input" id="password_confirmation" name="password_confirmation" type="password" minlength="8" maxlength="72" autocomplete="new-password" required></div>
        <div class="form-actions"><button class="btn" type="submit">Crear cuenta</button><a class="btn btn-ghost" href="/login">Ya tengo cuenta</a></div>
    </form>
</div></main>
<%- include('partials/footer') %>
</body></html>
