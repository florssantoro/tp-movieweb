<!DOCTYPE html>
<html>
<head>
    <title>Perfil de <%= person.person_name %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
<h1><%= person.person_name %></h1>
<p><strong>Perfil:</strong> Director</p>

<h2>Filmografía</h2>
<ul>
    <% credits.forEach((credit) => { %>
        <li>
            <a href="/pelicula/<%= credit.movie_id %>"><%= credit.title %></a>
            <% if (credit.release_date) { %>
                (<%= new Date(credit.release_date).getFullYear() %>)
            <% } %>
            — <strong>Rol:</strong> <%= credit.role %>
        </li>
    <% }); %>
</ul>
<p></p>
<div id="inicio"><a href="/">Inicio</a></div>
</body>
</html>
