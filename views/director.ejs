<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { pageTitle: person.person_name }) %>
</head>
<body>
<%- include('partials/header') %>
<%
const initials = String(person.person_name || '?').trim().split(/\s+/).slice(0, 2).map((word) => word[0]).join('').toUpperCase();
%>

<main class="page">
    <div class="container">
        <header class="profile-head">
            <span class="avatar avatar-lg" aria-hidden="true"><%= initials %></span>
            <div>
                <p class="eyebrow">Director</p>
                <h1><%= person.person_name %></h1>
                <p class="profile-meta"><%= credits.length %> <%= credits.length === 1 ? 'película' : 'películas' %></p>
            </div>
        </header>

        <section class="section" aria-labelledby="filmography-heading">
            <h2 class="section-title" id="filmography-heading">Filmografía</h2>
            <ul class="row-list">
                <% credits.forEach((credit) => { %>
                    <li class="row">
                        <span class="row-year"><%= credit.release_date ? new Date(credit.release_date).getFullYear() : '—' %></span>
                        <div class="row-body">
                            <a class="row-title" href="/pelicula/<%= credit.movie_id %>"><%= credit.title %></a>
                            <p class="row-detail"><strong>Rol:</strong> <%= credit.role %></p>
                        </div>
                    </li>
                <% }); %>
            </ul>
        </section>
    </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
