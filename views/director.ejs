<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= persona.person_name %> - MovieWeb</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header"><a class="brand" href="/">MovieWeb</a></header>
  <main class="container">
    <a class="back-link" href="/">Inicio</a>
    <h1><%= persona.person_name %></h1>
    <h2>Peliculas como director</h2>
    <% if (peliculas.length) { %>
      <ul class="result-list">
        <% peliculas.forEach((pelicula) => { %>
          <li><a href="/pelicula/<%= pelicula.movie_id %>"><%= pelicula.title %></a></li>
        <% }); %>
      </ul>
    <% } else { %><p>No hay peliculas registradas.</p><% } %>
  </main>
</body>
</html>
