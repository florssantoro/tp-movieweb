<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { pageTitle: 'Inicio' }) %>
</head>
<body>
<%- include('partials/header', { showSearch: false }) %>

<main class="hero">
    <div class="hero-inner">
        <h1>Películas, actores y directores.</h1>
        <p class="hero-lead">Buscá en una base de miles de películas y descubrí quién actuó, quién dirigió y de qué se trata cada una.</p>

        <form class="big-search" action="/buscar" method="GET" role="search">
            <input class="input" type="search" name="q" placeholder="Buscar películas, actores o directores..." aria-label="Buscar películas, actores o directores" required autofocus>
            <button class="btn" type="submit">Buscar</button>
        </form>

        <p class="hero-links">¿Buscás un tema? <a href="/keyword">Buscar por palabra clave</a></p>
        <div class="chips chips-center">
            <% ['time travel', 'prison', 'dystopia', 'heist', 'space'].forEach((keyword) => { %>
                <a class="chip" href="/keyword/resultados?q=<%= encodeURIComponent(keyword) %>"><%= keyword %></a>
            <% }); %>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
