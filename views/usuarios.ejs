<!DOCTYPE html>
<html>
<head>
    <title>Usuarios</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
<h1>Usuarios</h1>
<p><a href="/usuarios/nuevo">+ Nuevo usuario</a></p>

<% if (users.length === 0) { %>
    <p>Todavía no hay usuarios.</p>
<% } else { %>
    <ul>
        <% users.forEach((user) => { %>
            <li>
                <strong><a href="/usuarios/<%= user.user_id %>"><%= user.user_username %></a></strong>
                — <%= user.user_name %>
                (<%= user.user_email %>)
                                — <a href="/usuarios/<%= user.user_id %>/editar">Editar</a>
                <form action="/usuarios/<%= user.user_id %>/eliminar" method="POST" style="display: inline;"
                      onsubmit="return confirm('¿Eliminar a <%= user.user_username %>?');">
                    <button type="submit">Eliminar</button>
                </form>
            </li>
        <% }); %>
    </ul>
<% } %>

<p></p>
<div id="inicio"><a href="/">Inicio</a></div>
</body>
</html>