<% if (!movies.length) { %><p class="discovery-empty">Todavía no hay películas en esta selección. <a href="/explorar">Explorar el catálogo →</a></p><% } else { %>
<ul class="discovery-grid"><% movies.forEach((movie) => { %><li><a class="discovery-card" href="/pelicula/<%= movie.movie_id %>"><div class="discovery-poster"><span class="poster-placeholder" aria-hidden="true"><%= movie.title %></span><img src="<%= movie.posterUrl %>" alt="" width="342" height="513" loading="lazy" onerror="this.hidden=true"><% if (Number(movie.vote_average) > 0) { %><span class="movie-score">★ <%= Number(movie.vote_average).toFixed(1) %>/10</span><% } %></div><h3><%= movie.title %></h3><p><%= movie.release_date ? new Date(movie.release_date).getUTCFullYear() : 'Sin fecha' %><% if (movie.rating) { %> · Tu nota: <%= movie.rating %>/5<% } %></p></a><% if (movie.is_favorite || movie.watch_status) { %><p class="card-state"><%= [movie.is_favorite ? 'Favorita' : '', movie.watch_status === 'watched' ? 'Vista' : movie.watch_status === 'want_to_watch' ? 'Quiero ver' : ''].filter(Boolean).join(' · ') %></p><% } %></li><% }); %></ul><% } %>
