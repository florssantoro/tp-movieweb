<!DOCTYPE html><html lang="es"><head><%- include('partials/head', { pageTitle: 'Mi lista' }) %></head><body><%- include('partials/header') %><main class="discovery container"><header class="discovery-intro"><p class="eyebrow">TU RINCÓN DE CINE</p><h1>Mi lista</h1><p>Las que te esperan. Las que te encantaron. Las que ya son parte de tu historia.</p></header><nav class="filter-tabs" aria-label="Filtrar mi lista"><% [['want_to_watch','Quiero ver'],['favorite','Favoritas'],['watched','Vistas'],['all','Todas']].forEach(([value,label]) => { %><a href="/mi-lista?filtro=<%= value %>" <%- filter === value ? 'aria-current="page"' : '' %>><%= label %></a><% }); %></nav><p class="muted"><%= movies.length %> películas · Abrí una ficha para editar tu selección.</p><%- include('partials/movie_cards', { movies }) %></main><%- include('partials/footer') %></body></html>
