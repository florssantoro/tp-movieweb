<!DOCTYPE html>
<html lang="es">
<head><%- include('partials/head', { pageTitle: '¿Qué ver?' }) %></head>
<body>
<%- include('partials/header') %>
<% const moods = [['', 'Para descubrir'], ['comedia', 'Reír un rato'], ['terror', 'Un buen susto'], ['drama', 'Una gran historia'], ['corta', 'Hasta 100 minutos']]; %>
<main class="discovery container">
    <header class="explore-head">
        <p class="eyebrow">Una buena historia te espera</p>
        <h1>¿De qué tenés ganas?</h1>
        <p><%= locals.currentUser ? 'Tus favoritas y buenas puntuaciones nos orientan. Excluimos las que marcaste como vistas.' : 'Una selección de películas bien puntuadas para empezar. Ingresá para tener en cuenta tus gustos.' %></p>
    </header>

    <div class="explore-controls">
        <nav class="filter-tabs" aria-label="Tipo de sugerencia">
            <% moods.forEach(([value, label]) => { %>
                <a href="/que-ver?animo=<%= value %>" <%- mood === value ? 'aria-current="page"' : '' %>><%= label %></a>
            <% }); %>
        </nav>
        <p class="explore-count"><%= total.toLocaleString('es-AR') %> <%= total === 1 ? 'película' : 'películas' %> para elegir</p>
    </div>

    <%- include('partials/movie_cards', { movies }) %>

    <% if (totalPages > 1) { %>
    <nav class="pagination" aria-label="Páginas">
        <% if (page > 1) { %><a class="btn btn-ghost" href="/que-ver?animo=<%= mood %>&page=<%= page - 1 %>">← Anterior</a><% } %>
        <span>Página <strong><%= page %></strong> de <%= totalPages %></span>
        <% if (hasNext) { %><a class="btn btn-ghost" href="/que-ver?animo=<%= mood %>&page=<%= page + 1 %>">Siguiente →</a><% } %>
    </nav>
    <% } %>
</main>
<%- include('partials/footer') %>
</body>
</html>
