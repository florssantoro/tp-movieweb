<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { pageTitle: movie.title }) %>
</head>
<body class="movie-page">
<%
const releaseDate = movie.release_date ? new Date(movie.release_date) : null;
const validDate = releaseDate && !Number.isNaN(releaseDate.getTime());
const formattedDate = validDate ? new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(releaseDate) : null;
const formatNumber = (value) => Number(value).toLocaleString('es-AR', { maximumFractionDigits: 2 });
const directors = crew.filter((member) => member.job === 'Director');
const writers = crew.filter((member) => member.department_name === 'Writing');
const otherCrew = crew.filter((member) => member.job !== 'Director' && member.department_name !== 'Writing');
const featuredCast = cast.slice(0, 12);
const additionalCast = cast.slice(12);
const crewDepartments = otherCrew.reduce((groups, member) => {
    const departmentName = member.department_name || 'Otros';
    const existingGroup = groups.find((group) => group.name === departmentName);
    if (existingGroup) existingGroup.members.push(member);
    else groups.push({ name: departmentName, members: [member] });
    return groups;
}, []);
const primaryOverview = tmdb?.overview || movie.overview;
%>

<%- include('partials/header') %>

<div class="movie-hero"<% if (tmdb?.posterUrl) { %> style="--backdrop: url('<%= tmdb.posterUrl %>')"<% } %>>
    <div class="movie-lead">
        <div class="movie-poster">
            <% if (tmdb?.posterUrl) { %>
                <img src="<%= tmdb.posterUrl %>" alt="Póster de <%= movie.title %>" width="500" height="750">
            <% } else { %>
                <span>Sin póster disponible</span>
            <% } %>
        </div>
        <div class="movie-intro">
            <p class="movie-eyebrow">Película <%= validDate ? '· ' + releaseDate.getUTCFullYear() : '' %></p>
            <h1><%= movie.title %></h1>
            <% if (movie.tagline) { %><p class="movie-tagline"><%= movie.tagline %></p><% } %>
            <div class="movie-summary">
                <% if (genres.length) { %><p><strong>Géneros</strong> <%= genres.map((item) => item.genre_name).join(' · ') %></p><% } %>
                <% if (countries.length) { %><p><strong>Países</strong> <%= countries.map((item) => item.country_name).join(' · ') %></p><% } %>
                <% if (movie.runtime != null) { %><p><strong>Duración</strong> <%= movie.runtime %> min</p><% } %>
                <% if (formattedDate) { %><p><strong>Estreno</strong> <%= formattedDate %></p><% } %>
            </div>
            <% if (ratingsAvailable) { const quick = locals.interaction || {}; const hasWatched = quick.watch_status === 'watched'; const wantsToWatch = quick.watch_status === 'want_to_watch'; %>
            <div class="movie-actions">
                <% if (locals.selectedUser) { %>
                    <form action="/pelicula/<%= movie.movie_id %>/estado" method="POST">
                        <input type="hidden" name="toggle" value="favorite">
                        <button class="action-toggle action-favorite" type="submit" aria-pressed="<%= quick.is_favorite ? 'true' : 'false' %>"><span aria-hidden="true">♥</span><%= quick.is_favorite ? 'En favoritas' : 'Favorita' %></button>
                    </form>
                    <form action="/pelicula/<%= movie.movie_id %>/estado" method="POST">
                        <input type="hidden" name="toggle" value="watched">
                        <button class="action-toggle action-watched" type="submit" aria-pressed="<%= hasWatched ? 'true' : 'false' %>" aria-label="<%= hasWatched ? 'Quitar de vistas' : 'Marcar como vista' %>"><span aria-hidden="true"><%= hasWatched ? '✓' : '+' %></span><%= hasWatched ? 'Vista' : 'Marcar como vista' %></button>
                    </form>
                    <form action="/pelicula/<%= movie.movie_id %>/estado" method="POST">
                        <input type="hidden" name="toggle" value="want_to_watch">
                        <button class="action-toggle action-want" type="submit" aria-pressed="<%= wantsToWatch ? 'true' : 'false' %>" aria-label="<%= wantsToWatch ? 'Quitar de Quiero ver' : 'Agregar a Quiero ver' %>"><span aria-hidden="true"><%= wantsToWatch ? '✓' : '+' %></span><%= wantsToWatch ? 'En Quiero ver' : 'Agregar a Quiero ver' %></button>
                    </form>
                <% } else { %>
                    <a class="action-toggle action-favorite" href="/login"><span aria-hidden="true">♥</span>Favorita</a>
                    <a class="action-toggle action-watched" href="/login"><span aria-hidden="true">+</span>Marcar como vista</a>
                    <a class="action-toggle action-want" href="/login"><span aria-hidden="true">+</span>Agregar a Quiero ver</a>
                <% } %>
            </div>
            <% } %>
            <div class="movie-links">
                <% if (tmdb?.url) { %><a href="<%= tmdb.url %>" target="_blank" rel="noopener noreferrer">Ficha en TMDB ↗</a><% } %>
                <% if (tmdb?.trailerUrl) { %><a href="#trailer">Ver tráiler ↓</a><% } %>
                <a href="#rate-heading">Escribir reseña ↓</a>
            </div>
        </div>
    </div>
</div>

<main class="movie-main">
    <section class="movie-section" aria-labelledby="synopsis-heading">
        <h2 id="synopsis-heading">Sinopsis</h2>
        <% if (primaryOverview) { %>
            <p class="movie-overview"><%= primaryOverview %></p>
            <% if (tmdb?.overview && movie.overview) { %>
                <details class="movie-alternate">
                    <summary>Leer sinopsis de la base de datos</summary>
                    <p><%= movie.overview %></p>
                </details>
            <% } %>
        <% } else { %>
            <p class="movie-muted">No hay sinopsis disponible.</p>
        <% } %>
    </section>

    <% if (tmdb?.trailerEmbedUrl) { %>
    <section class="movie-section" id="trailer" aria-labelledby="trailer-heading">
        <div class="movie-section-heading">
            <h2 id="trailer-heading">Tráiler</h2>
            <a href="<%= tmdb.trailerUrl %>" target="_blank" rel="noopener noreferrer">Abrir en YouTube ↗</a>
        </div>
        <div class="movie-video">
            <iframe src="<%= tmdb.trailerEmbedUrl %>" title="Tráiler de <%= movie.title %>" loading="lazy" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
    </section>
    <% } %>

    <section class="movie-section" aria-labelledby="facts-heading">
        <h2 id="facts-heading">Ficha técnica</h2>
        <dl class="movie-facts">
            <% if (movie.movie_status) { %><div><dt>Estado</dt><dd><%= movie.movie_status %></dd></div><% } %>
            <% if (movie.budget != null) { %><div><dt>Presupuesto</dt><dd><%= movie.budget > 0 ? formatNumber(movie.budget) : 'No informado' %></dd></div><% } %>
            <% if (movie.revenue != null) { %><div><dt>Recaudación</dt><dd><%= movie.revenue > 0 ? formatNumber(movie.revenue) : 'No informada' %></dd></div><% } %>
            <% if (movie.popularity != null) { %><div><dt>Popularidad</dt><dd><%= formatNumber(movie.popularity) %></dd></div><% } %>
            <% if (movie.vote_average != null) { %><div><dt>Calificación</dt><dd><%= formatNumber(movie.vote_average) %> / 10</dd></div><% } %>
            <% if (movie.vote_count != null) { %><div><dt>Votos</dt><dd><%= formatNumber(movie.vote_count) %></dd></div><% } %>
            <% if (languages.length) { %><div><dt>Idiomas</dt><dd><%= languages.map((item) => item.language_name + (item.language_role ? ' (' + item.language_role + ')' : '')).join(', ') %></dd></div><% } %>
            <% if (companies.length) { %><div><dt>Productoras</dt><dd><%= companies.map((item) => item.company_name).join(', ') %></dd></div><% } %>
            <% if (keywords.length) { %><div><dt>Palabras clave</dt><dd><% keywords.forEach((item, index) => { %><%= index ? ', ' : '' %><a href="/buscar?tipo=keyword&amp;q=<%= encodeURIComponent(item.keyword_name) %>"><%= item.keyword_name %></a><% }); %></dd></div><% } %>
        </dl>
    </section>

    <section class="movie-section" aria-labelledby="credits-heading">
        <h2 id="credits-heading">Créditos</h2>
        <div class="movie-credit-groups">
            <div>
                <h3>Dirección</h3>
                <% if (directors.length) { %><ul class="movie-credits"><% directors.forEach((member) => { %><li><% if (member.linkable !== false) { %><a href="/director/<%= member.person_id %>"><%= member.person_name %></a><% } else { %><span><%= member.person_name %></span><% } %></li><% }); %></ul><% } else { %><p class="movie-muted">Sin datos.</p><% } %>
            </div>
            <div>
                <h3>Guion</h3>
                <% if (writers.length) { %><ul class="movie-credits"><% writers.forEach((member) => { %><li><span><%= member.person_name %></span><small><%= member.job %></small></li><% }); %></ul><% } else { %><p class="movie-muted">Sin datos.</p><% } %>
            </div>
        </div>
    </section>

    <section class="movie-section" aria-labelledby="cast-heading">
        <h2 id="cast-heading">Elenco <span class="movie-count"><%= cast.length %></span></h2>
        <% if (cast.length) { %>
            <ol class="movie-credits movie-credits-grid"><% featuredCast.forEach((actor) => { %>
                <li><% if (actor.linkable !== false) { %><a href="/actor/<%= actor.person_id %>"><%= actor.person_name %></a><% } else { %><span><%= actor.person_name %></span><% } %><% if (actor.character_name) { %><small><%= actor.character_name %></small><% } %></li>
            <% }); %></ol>
            <% if (additionalCast.length) { %>
                <details class="movie-disclosure">
                    <summary>Ver elenco completo (<%= cast.length %>)</summary>
                    <ol class="movie-credits movie-credits-grid movie-credits-additional"><% additionalCast.forEach((actor) => { %>
                        <li><% if (actor.linkable !== false) { %><a href="/actor/<%= actor.person_id %>"><%= actor.person_name %></a><% } else { %><span><%= actor.person_name %></span><% } %><% if (actor.character_name) { %><small><%= actor.character_name %></small><% } %></li>
                    <% }); %></ol>
                </details>
            <% } %>
        <% } else { %><p class="movie-muted">Sin datos de elenco.</p><% } %>
    </section>

    <section class="movie-section" aria-labelledby="crew-heading">
        <h2 id="crew-heading">Equipo técnico <span class="movie-count"><%= otherCrew.length %></span></h2>
        <% if (otherCrew.length) { %>
            <div class="movie-crew-groups"><% crewDepartments.forEach((department) => { %>
                <details class="movie-crew-department">
                    <summary><span><%= department.name %></span><span class="movie-count"><%= department.members.length %></span></summary>
                    <ul class="movie-credits movie-credits-grid"><% department.members.forEach((member) => { %>
                        <li><span><%= member.person_name %></span><small><%= member.job %></small></li>
                    <% }); %></ul>
                </details>
            <% }); %></div>
        <% } else { %><p class="movie-muted">Sin datos de equipo técnico.</p><% } %>
    </section>
    
    <section class="movie-section" aria-labelledby="rate-heading">
        <% const activeUser = locals.selectedUser || null; const savedInteraction = locals.interaction || null; %>
        <h2 id="rate-heading">Tu reseña</h2>
        <% if (!ratingsAvailable) { %>
            <p class="movie-muted">Las interacciones no están disponibles temporalmente.</p>
        <% } else if (!activeUser) { %>
            <div class="auth-callout">
                <p>Ingresá a tu cuenta para puntuar esta película o escribir una opinión.</p>
                <div class="form-actions"><a class="btn" href="/login">Ingresar</a><a class="btn btn-ghost" href="/registro">Crear cuenta</a></div>
            </div>
        <% } else { const saved = savedInteraction || {}; %>
            <form class="form-card movie-rate" action="/pelicula/<%= movie.movie_id %>/calificar" method="POST">
                <p class="interaction-summary"><strong><%= activeUser.user_username %></strong> · <%= savedInteraction ? [saved.is_favorite ? 'Favorita' : '', saved.watch_status === 'want_to_watch' ? 'Quiero ver' : saved.watch_status === 'watched' ? 'Vista' : '', saved.rating ? `${saved.rating}/5` : '', saved.opinion ? 'Con opinión' : ''].filter(Boolean).join(' · ') || 'Sin estados guardados' : 'Todavía no guardaste esta película' %></p>
                <div class="form-row">
                    <div class="field">
                        <label for="rate-stars">Puntuación</label>
                        <select class="select" id="rate-stars" name="rating">
                            <option value="">Sin puntuación</option>
                            <% for (let stars = 5; stars >= 1; stars--) { %>
                                <option value="<%= stars %>" <%= saved.rating === stars ? 'selected' : '' %>><%= '★'.repeat(stars) %> (<%= stars %>)</option>
                            <% } %>
                        </select>
                    </div>
                </div>
                <div class="field">
                    <label for="rate-opinion">Opinión</label>
                    <textarea class="textarea" id="rate-opinion" name="opinion" rows="4" maxlength="1000" aria-describedby="opinion-help" placeholder="¿Qué te pareció?"><%= saved.opinion || '' %></textarea>
                    <small id="opinion-help" class="movie-muted">Opcional · Hasta 1000 caracteres.</small>
                </div>
                <div class="form-actions">
                    <button class="btn" type="submit">Guardar reseña</button>
                </div>
            </form>
            <% if (savedInteraction) { %>
            <form class="interaction-remove" action="/pelicula/<%= movie.movie_id %>/interaccion" method="POST" onsubmit="return confirm('¿Quitar esta película de tu perfil junto con su puntuación y opinión?');">
                <button class="btn btn-ghost btn-sm" type="submit" name="action" value="remove">Quitar asociación</button>
                <small class="movie-muted">También elimina tu puntuación y opinión.</small>
            </form>
            <% } %>
        <% } %>
    </section>

    <% if (locals.communityReviews?.available) { %>
    <%
    const community = locals.communityReviews;
    const myId = locals.selectedUser?.user_id;
    // Todas las reseñas de la película; la tuya va primero y marcada.
    const allReviews = [...community.items].sort((a, b) => Number(b.user_id === myId) - Number(a.user_id === myId));
    const shownReviews = allReviews.slice(0, 6);
    const moreReviews = allReviews.slice(6);
    const reviewDate = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Argentina/Buenos_Aires' });
    const reviewInitials = (review) => String(review.user_name || review.user_username || '?').trim().split(/\s+/).slice(0, 2).map((word) => word[0]).join('').toUpperCase();
    %>
    <section class="movie-section" aria-labelledby="community-heading">
        <div class="movie-section-heading">
            <h2 id="community-heading">Reseñas de la comunidad <span class="movie-count"><%= community.total %></span></h2>
            <% if (community.average !== null) { %>
                <p class="community-average"><span class="stars" aria-hidden="true">★</span> <strong><%= community.average.toLocaleString('es-AR') %></strong> / 5 · <%= community.ratings %> <%= community.ratings === 1 ? 'puntuación' : 'puntuaciones' %></p>
            <% } %>
        </div>
        <% if (allReviews.length === 0) { %>
            <p class="movie-muted">Todavía nadie reseñó esta película. ¡Podés ser el primero!</p>
        <% } else { %>
            <% const renderReviews = (list) => list.forEach((review) => { %>
                <li class="review-card<%= review.user_id === myId ? ' review-card-mine' : '' %>">
                    <div class="review-head">
                        <a class="review-author" href="/usuarios/<%= review.user_id %>"><span class="avatar" aria-hidden="true"><%= reviewInitials(review) %></span><%= review.user_username %></a>
                        <% if (review.user_id === myId) { %><span class="review-mine">Tu reseña</span><% } %>
                        <% if (review.rating) { %><span class="stars" aria-label="<%= review.rating %> de 5"><%= '★'.repeat(review.rating) %><span class="stars-off"><%= '★'.repeat(5 - review.rating) %></span></span><% } %>
                        <% if (review.updated_at) { %><time class="review-date" datetime="<%= new Date(review.updated_at).toISOString() %>"><%= reviewDate.format(new Date(review.updated_at)) %></time><% } %>
                    </div>
                    <% if (review.opinion) { %><p class="review-text"><%= review.opinion %></p><% } else { %><p class="review-text movie-muted">Puntuó sin escribir opinión.</p><% } %>
                </li>
            <% }); %>
            <ul class="review-list"><% renderReviews(shownReviews); %></ul>
            <% if (moreReviews.length) { %>
                <details class="movie-disclosure">
                    <summary>Ver todas (<%= allReviews.length %>)</summary>
                    <ul class="review-list movie-credits-additional"><% renderReviews(moreReviews); %></ul>
                </details>
            <% } %>
        <% } %>
    </section>
    <% } %>
</main>

<footer class="site-footer">
    <div class="container">
        <a class="brand" href="/">MovieWeb</a>
        <% if (tmdb) { %>
            <div class="movie-attribution">
                <span>Imágenes y tráiler de</span>
                <a href="https://www.themoviedb.org" target="_blank" rel="noopener noreferrer"><img src="/tmdb-logo.svg" alt="TMDB" width="54" height="39"></a>
            </div>
        <% } else { %>
            <span>Trabajo práctico · Bases de Datos 2026</span>
        <% } %>
    </div>
</footer>
</body>
</html>
