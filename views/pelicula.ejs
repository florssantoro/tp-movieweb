<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= movie.title %> · MovieWeb</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="movie-page">
<%
const releaseDate = movie.release_date ? new Date(movie.release_date) : null;
const validDate = releaseDate && !Number.isNaN(releaseDate.getTime());
const formattedDate = validDate ? new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(releaseDate) : null;
const formatNumber = (value) => Number(value).toLocaleString('es-AR', { maximumFractionDigits: 2 });
const directors = crew.filter((member) => member.job === 'Director');
const writers = crew.filter((member) => member.department_name === 'Writing');
const otherCrew = crew.filter((member) => member.job !== 'Director' && member.department_name !== 'Writing');
const primaryOverview = tmdb?.overview || movie.overview;
%>

<header class="movie-header">
    <a class="movie-brand" href="/">MovieWeb</a>
    <a class="movie-back" href="/">Volver al inicio</a>
</header>

<main class="movie-main">
    <div class="movie-lead">
        <div class="movie-poster">
            <% if (tmdb?.posterUrl) { %>
                <img src="<%= tmdb.posterUrl %>" alt="Póster de <%= movie.title %>" width="500" height="750">
            <% } else { %>
                <span>Sin póster disponible</span>
            <% } %>
        </div>
        <div class="movie-intro">
            <p class="movie-eyebrow">Película <%= validDate ? '· ' + releaseDate.getUTCFullYear() : '' %></p>
            <h1><%= movie.title %></h1>
            <% if (movie.tagline) { %><p class="movie-tagline"><%= movie.tagline %></p><% } %>
            <div class="movie-summary">
                <% if (genres.length) { %><p><strong>Géneros</strong> <%= genres.map((item) => item.genre_name).join(' · ') %></p><% } %>
                <% if (countries.length) { %><p><strong>Países</strong> <%= countries.map((item) => item.country_name).join(' · ') %></p><% } %>
                <% if (movie.runtime != null) { %><p><strong>Duración</strong> <%= movie.runtime %> min</p><% } %>
                <% if (formattedDate) { %><p><strong>Estreno</strong> <%= formattedDate %></p><% } %>
            </div>
            <div class="movie-links">
                <% if (movieHomepage) { %><a href="<%= movieHomepage %>" target="_blank" rel="noopener noreferrer">Sitio oficial ↗</a><% } %>
                <% if (tmdb?.homepage && tmdb.homepage !== movieHomepage) { %><a href="<%= tmdb.homepage %>" target="_blank" rel="noopener noreferrer">Sitio web (TMDB) ↗</a><% } %>
                <% if (tmdb?.url) { %><a href="<%= tmdb.url %>" target="_blank" rel="noopener noreferrer">Ficha en TMDB ↗</a><% } %>
                <% if (tmdb?.trailerUrl) { %><a href="#trailer">Ver tráiler ↓</a><% } %>
            </div>
        </div>
    </div>

    <section class="movie-section" aria-labelledby="synopsis-heading">
        <h2 id="synopsis-heading">Sinopsis</h2>
        <% if (primaryOverview) { %>
            <p class="movie-overview"><%= primaryOverview %></p>
            <% if (tmdb?.overview && movie.overview) { %>
                <details class="movie-alternate">
                    <summary>Leer sinopsis de la base de datos</summary>
                    <p><%= movie.overview %></p>
                </details>
            <% } %>
        <% } else { %>
            <p class="movie-muted">No hay sinopsis disponible.</p>
        <% } %>
    </section>

    <% if (tmdb?.trailerEmbedUrl) { %>
    <section class="movie-section" id="trailer" aria-labelledby="trailer-heading">
        <div class="movie-section-heading">
            <h2 id="trailer-heading">Tráiler</h2>
            <a href="<%= tmdb.trailerUrl %>" target="_blank" rel="noopener noreferrer">Abrir en YouTube ↗</a>
        </div>
        <div class="movie-video">
            <iframe src="<%= tmdb.trailerEmbedUrl %>" title="Tráiler de <%= movie.title %>" loading="lazy" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
    </section>
    <% } %>

    <section class="movie-section" aria-labelledby="facts-heading">
        <h2 id="facts-heading">Ficha técnica</h2>
        <dl class="movie-facts">
            <% if (movie.movie_status) { %><div><dt>Estado</dt><dd><%= movie.movie_status %></dd></div><% } %>
            <% if (movie.budget != null) { %><div><dt>Presupuesto</dt><dd><%= movie.budget > 0 ? formatNumber(movie.budget) : 'No informado' %></dd></div><% } %>
            <% if (movie.revenue != null) { %><div><dt>Recaudación</dt><dd><%= movie.revenue > 0 ? formatNumber(movie.revenue) : 'No informada' %></dd></div><% } %>
            <% if (movie.popularity != null) { %><div><dt>Popularidad</dt><dd><%= formatNumber(movie.popularity) %></dd></div><% } %>
            <% if (movie.vote_average != null) { %><div><dt>Calificación</dt><dd><%= formatNumber(movie.vote_average) %> / 10</dd></div><% } %>
            <% if (movie.vote_count != null) { %><div><dt>Votos</dt><dd><%= formatNumber(movie.vote_count) %></dd></div><% } %>
            <% if (languages.length) { %><div><dt>Idiomas</dt><dd><%= languages.map((item) => item.language_name + (item.language_role ? ' (' + item.language_role + ')' : '')).join(', ') %></dd></div><% } %>
            <% if (companies.length) { %><div><dt>Productoras</dt><dd><%= companies.map((item) => item.company_name).join(', ') %></dd></div><% } %>
            <% if (keywords.length) { %><div><dt>Palabras clave</dt><dd><%= keywords.map((item) => item.keyword_name).join(', ') %></dd></div><% } %>
        </dl>
    </section>

    <section class="movie-section" aria-labelledby="credits-heading">
        <h2 id="credits-heading">Créditos</h2>
        <div class="movie-credit-groups">
            <div>
                <h3>Dirección</h3>
                <% if (directors.length) { %><ul class="movie-credits"><% directors.forEach((member) => { %><li><a href="/director/<%= member.person_id %>"><%= member.person_name %></a></li><% }); %></ul><% } else { %><p class="movie-muted">Sin datos.</p><% } %>
            </div>
            <div>
                <h3>Guion</h3>
                <% if (writers.length) { %><ul class="movie-credits"><% writers.forEach((member) => { %><li><span><%= member.person_name %></span><small><%= member.job %></small></li><% }); %></ul><% } else { %><p class="movie-muted">Sin datos.</p><% } %>
            </div>
        </div>
    </section>

    <section class="movie-section" aria-labelledby="cast-heading">
        <h2 id="cast-heading">Elenco <span class="movie-count"><%= cast.length %></span></h2>
        <% if (cast.length) { %>
            <ol class="movie-credits movie-credits-grid"><% cast.forEach((actor) => { %>
                <li><a href="/actor/<%= actor.person_id %>"><%= actor.person_name %></a><% if (actor.character_name) { %><small><%= actor.character_name %></small><% } %></li>
            <% }); %></ol>
        <% } else { %><p class="movie-muted">Sin datos de elenco.</p><% } %>
    </section>

    <section class="movie-section" aria-labelledby="crew-heading">
        <h2 id="crew-heading">Equipo técnico <span class="movie-count"><%= otherCrew.length %></span></h2>
        <% if (otherCrew.length) { %>
            <ul class="movie-credits movie-credits-grid"><% otherCrew.forEach((member) => { %>
                <li><span><%= member.person_name %></span><small><%= member.job %><%= member.department_name ? ' · ' + member.department_name : '' %></small></li>
            <% }); %></ul>
        <% } else { %><p class="movie-muted">Sin datos de equipo técnico.</p><% } %>
    </section>
</main>

<footer class="movie-footer">
    <% if (tmdb) { %>
        <div class="movie-attribution">
            <a href="https://www.themoviedb.org" target="_blank" rel="noopener noreferrer"><img src="/tmdb-logo.svg" alt="TMDB" width="54" height="39"></a>
            <p>Este producto utiliza la API de TMDB, pero no está avalado ni certificado por TMDB.</p>
        </div>
    <% } %>
    <a href="/">MovieWeb</a>
</footer>
</body>
</html>
